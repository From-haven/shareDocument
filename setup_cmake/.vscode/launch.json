{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch CMake Target",
            "type": "cppdbg",
            "request": "launch",
            // Tự động lấy đường dẫn file thực thi đang được chọn bởi CMake Tools
            "program": "${command:cmake.launchTargetPath}",
            "args": [], // Thêm các tham số command line vào đây nếu chương trình cần
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}